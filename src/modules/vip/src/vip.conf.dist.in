#####################################
# VIP Module Configuration          #
#####################################

[VipConf]
ConfVersion=2

###################################################################################################################
# VIP MODULE CONFIGURATION
#
#    Vip.Enable
#        Enable the VIP module + .vip grant/revoke chat commands + the master-spell cascade.
#        Default: 0 (off)
#                 1 (on)
#
#    Vip.MasterSpellId
#        ID of the single "Wayfarer's Boon" spell taught to VIPs. The spell
#        row itself is a no-op on the engine side (Effect1 = SPELL_EFFECT_DUMMY);
#        VipModule::OnCast detects this ID and cascades into Vip.BundledSpellIds.
#        The matching spell_template row is provisioned by
#        etc/emberstone/sql/world/vip-master-spell.sql in this repo.
#        Default: 91200
#
#    Vip.BundledSpellIds
#        Comma-separated list of spell IDs the master cascades into when cast.
#        Each is cast as a triggered spell on the caster (bypasses GCD / mana
#        cost / cast time) and retains its original duration. Empty / unset
#        uses the built-in defaults:
#
#          22888  Rallying Cry of the Dragonslayer (Onyxia/Nef head buff)
#          24425  Spirit of Zandalar
#          23735  Mol'dar's Moxie       (DM tribute)
#          23736  Fengus' Ferocity      (DM tribute)
#          23737  Slip'kik's Savvy      (DM tribute)
#          15366  Songflower Serenade
#          16609  Warchief's Blessing
#          17626  Greater Arcane Elixir
#          17627  Distilled Wisdom flask
#          17628  Supreme Power flask
#
#        Override here to extend / trim. Whitespace ignored.
#        Default: "" (use built-in list)
#
###################################################################################################################

Vip.Enable = 1
Vip.MasterSpellId = 91200
Vip.BundledSpellIds = ""
